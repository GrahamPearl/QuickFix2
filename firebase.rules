rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function userDoc(id) {
      return /databases/$(database)/documents/authorized_users/$(id);
    }
    
    function myEmail() { 
      return request.auth != null && request.auth.token.email is string 
        ? request.auth.token.email.lower() 
        : ''; 
    }

    // Type of the signed-in user. Email document first (that is how admin_user.js keys them),
    // uid document as a fallback. '' if not listed.
    function myType() {
      let email = myEmail();
      return request.auth == null ? '' :
        (email != '' && exists(userDoc(email))
          ? get(userDoc(email)).data.type.lower()
          : (exists(userDoc(request.auth.uid))
              ? get(userDoc(request.auth.uid)).data.type.lower()
              : ''));
    }

    function canViewAwards()      { return typeIn(['admin','staff-head','staff-gc','staff-office','staff']); }
    function canRecommendAwards() { return typeIn(['admin','staff-head','staff-gc','staff-office','staff']); }
    function canApproveAwards()   { return typeIn(['admin','staff-head']); }
    
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function typeIn(list) { 
      let t = myType(); 
      return t != '' && t in list; 
    }

    function canRead()            { return typeIn(['admin','staff-head','staff-gc','staff-office','staff','slt']); }
    function isAdmin()            { return typeIn(['admin']); }
    function isAdminOrHead()      { return typeIn(['admin','staff-head']); }
    function canEditStudents()    { return typeIn(['admin','staff-head','staff-gc']); }
    function canEditTeams()       { return typeIn(['admin','staff-head','staff-gc']); }
    function isHallStaff()        { return typeIn(['admin','staff-head','staff-gc','staff']); }
    function isHallReviewer()     { return typeIn(['admin','staff-head','staff-gc']); }

    // ---------- awards recommendations ----------
    match /awards-recommendations/{id} {
      allow read: if canViewAwards();
 
      allow create: if canRecommendAwards()
        && request.resource.data.keys().hasOnly(['adminNo','studentName','grade','class','teamName','ageGroup',
             'awardLevel','note','nonMember','reAward','priorCount','status',
             'recommendedBy','recommendedByEmail','recommendedAt'])
        && request.resource.data.keys().hasAll(['adminNo','studentName','teamName','awardLevel','status',
             'recommendedBy','recommendedByEmail','recommendedAt'])
        && request.resource.data.adminNo is string
        && request.resource.data.adminNo.matches('[0-9]{5,6}')
        && request.resource.data.status == 'pending'
        && request.resource.data.recommendedBy == request.auth.uid
        && request.resource.data.recommendedByEmail == myEmail()
        && request.resource.data.recommendedAt == request.time
        && request.resource.data.awardLevel in ['merits','halfColours','fullColours']
        && request.resource.data.get('note', '').size() <= 300;
 
      allow update: if (
        // withdraw: any recommender, any pending recommendation
        (canRecommendAwards()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.withdrawnBy == request.auth.uid
            && request.resource.data.withdrawnByEmail == myEmail()
            && request.resource.data.withdrawnAt == request.time
            && onlyChanges(['status','withdrawnBy','withdrawnByEmail','withdrawnAt']))
        || (canApproveAwards() && (
            // approve (confirmed) or decline (rejected)
            (resource.data.status == 'pending'
              && request.resource.data.confirmedBy == request.auth.uid
              && request.resource.data.confirmedByEmail == myEmail()
              && request.resource.data.confirmedAt == request.time
              && onlyChanges(['status','confirmedBy','confirmedByEmail','confirmedAt','issuedDate',
                              'schoolYear','nonMemberConfirmed','reAward','priorCount','rejectedReason'])
              && ((request.resource.data.status == 'rejected'
                    && request.resource.data.get('rejectedReason', '').size() > 0)
                  || (request.resource.data.status == 'confirmed'
                      && request.resource.data.issuedDate is string
                      && request.resource.data.issuedDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                      && request.resource.data.schoolYear is int
                      && request.resource.data.schoolYear >= 2000
                      && request.resource.data.schoolYear <= 2100
                      && (resource.data.get('nonMember', false) == false
                          || request.resource.data.get('nonMemberConfirmed', false) == true))))
            ||
            // revoke a confirmed award
            (resource.data.status == 'confirmed'
              && request.resource.data.status == 'revoked'
              && request.resource.data.revokedBy == request.auth.uid
              && request.resource.data.revokedByEmail == myEmail()
              && request.resource.data.revokedAt == request.time
              && request.resource.data.get('revokedReason', '').size() > 0
              && onlyChanges(['status','revokedBy','revokedByEmail','revokedAt','revokedReason']))
          ))
      );
 
      allow delete: if false;
    }

    // ---------- users ----------
    match /authorized_users/{id} {
      allow get:   if request.auth != null && request.auth.token.email != null
                     && (id == request.auth.uid || id == myEmail() || isAdminOrHead());
      allow list:  if isAdminOrHead();
      allow write: if isAdminOrHead();
    }

    // ---------- students ----------
    match /students/{adminNo} {
      allow read:         if canRead();
      allow create, update: if canEditStudents();
      allow delete:         if isAdmin();
    }

    // ---------- teams ----------
    match /teams/{id} {
      allow read:  if canRead();
      allow write: if canEditTeams();
    }
    match /config/{id} {
      allow read, write: if isAdminOrHead();
    }

    // ---------- shared settings, notices, timetables ----------
    match /setting/{id} {
      allow read:  if canRead();
      allow write: if isAdminOrHead();
    }
    match /notices/{id} {
      allow read:  if myType() != '';
      allow write: if isAdminOrHead();
    }
    match /timetables/{id} {
      allow read:  if canRead();
      allow write: if isAdminOrHead();
    }

    // ---------- hall passes ----------
    match /history-hall-pass/{id} {
      allow create: if isHallStaff();
      allow read:   if isHallReviewer();
      allow update, delete: if false;
    }

    // ---------- seating ----------
    match /seatingPlans/{id} {
      allow read, write: if canRead();
    }
    match /lsuSeatingVenues/{id} {
      allow read:  if canRead();
      allow write: if canEditStudents();
    }

    // ---------- admin logs & metadata ----------
    match /allocation-batches/{id} { allow read, write: if isAdmin(); }
    match /import-batches/{id}     { allow read, write: if isAdmin(); }

    match /rosterSnapshot/{id} {
      allow read:  if canRead();
      allow write: if canEditStudents();
    }
    match /audit-log/{id} {
      allow create: if (canEditStudents()
                        || (canRecommendAwards() && request.resource.data.action.matches('award[.].*')))
                       && request.resource.data.by == request.auth.uid;
      allow read:   if isAdminOrHead();
      allow update, delete: if false;
    }
    match /usage-daily/{id} {
      allow create, update: if canRead() && request.resource.data.uid == request.auth.uid
                            && id.matches('.*_' + request.auth.uid);
      allow read: if isAdminOrHead();
    }
    match /usage-summary/{id} {
      allow create, update: if canRead();
      allow read: if isAdminOrHead();
    }
    match /active-hall-passes/{email} {
      allow read:  if isHallStaff() && (email == myEmail() || isHallReviewer());
      allow write: if isHallStaff() && (email == myEmail() || isHallReviewer());
    }
    match /hallpass-index/{id} {
      allow read, write: if isHallStaff();
    }

    match /concessions/{adminNo} {
     allow read: if typeIn(['admin','staff-head','staff-gc']);
     allow create, update: if typeIn(['admin','staff-head','staff-gc'])
       && request.resource.data.adminNo == adminNo
       && request.resource.data.types is list;
     allow delete: if typeIn(['admin','staff-head','staff-gc']);
   }

   function memoryGameSeason() {
  return exists(/databases/$(database)/documents/setting/memoryGame)
    ? string(get(/databases/$(database)/documents/setting/memoryGame).data.get('season', 1))
    : '1';
}

match /memory-game-seasons/{season}/scores/{uid} {
  allow read: if canRead();
  allow create, update: if canRead()
    && uid == request.auth.uid
    && season == memoryGameSeason()
    && request.resource.data.keys().hasOnly(['uid','email','name','bestScore','bestTimeMs','bestCorrect',
         'rounds','games','totalPlayMs','sortKey','updatedAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.email == myEmail()
    && request.resource.data.bestScore is int && request.resource.data.bestScore >= 0 && request.resource.data.bestScore <= 10000
    && request.resource.data.bestTimeMs is int && request.resource.data.bestTimeMs >= 0 && request.resource.data.bestTimeMs <= 3600000
    && request.resource.data.bestCorrect is int && request.resource.data.rounds is int
    && request.resource.data.games is int && request.resource.data.games >= 1
    && request.resource.data.totalPlayMs is int && request.resource.data.sortKey is int
    && request.resource.data.updatedAt == request.time
    && (resource == null || request.resource.data.bestScore >= resource.data.bestScore);
  allow delete: if isAdminOrHead();
}

function canAddBehaviour() { return typeIn(['admin','staff-head','staff-gc','staff','slt']); } 
function canManageBehaviour() { return typeIn(['admin','staff-head','staff-gc']); } 
function isBehaviourAdmin() { return typeIn(['admin','staff-head']); }

match /behaviour-entries/{id} { allow read: if isBehaviourAdmin() || (typeIn(['staff-gc']) && resource.data.severity in ['minor','moderate']) || (canAddBehaviour() && resource.data.recordedBy == request.auth.uid && resource.data.recordedAt > request.time - duration.value(1, 'd')); 
allow create: if canAddBehaviour() && request.resource.data.recordedBy == request.auth.uid && request.resource.data.recordedByEmail == myEmail() && request.resource.data.recordedAt == request.time && request.resource.data.status == 'active' && request.resource.data.type in ['uniform','merit','demerit','incident'] && request.resource.data.severity in ['minor','moderate','serious'] && request.resource.data.adminNo.matches('[0-9]{5,6}') && request.resource.data.get('note','').size() <= 300; 


// void only: managers, and gc never on serious entries allow update: if canManageBehaviour() && (isBehaviourAdmin() || resource.data.severity != 'serious') && resource.data.status == 'active' && request.resource.data.status == 'voided' && request.resource.data.diff(resource.data).affectedKeys() .hasOnly(['status','voidedBy','voidedByEmail','voidedAt','voidedReason']); allow delete: if isBehaviourAdmin(); } match /detentions/{id} { allow read, create, update: if canManageBehaviour(); allow delete: if isBehaviourAdmin(); }
  }
}
}